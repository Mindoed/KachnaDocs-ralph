{
  "name": "@kachnadocs/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:test": "node scripts/migrate.mjs up --env=test",
    "seed": "ts-node src/seed.ts",
    "seed:test": "ts-node src/seed.ts --env=test",
    "test": "jest --passWithNoTests --testPathIgnorePatterns .e2e-spec.ts",
    "test:e2e": "jest --passWithNoTests --testMatch \"<rootDir>/test/**/*.e2e-spec.ts\""
  },
  "dependencies": {
    "@kachnadocs/shared": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.2",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "lib0": "^0.2.118",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}

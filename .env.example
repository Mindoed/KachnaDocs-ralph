# --- Database ------------------------------------------------------------
# User/password/database match docker-compose.yml.
DATABASE_URL=postgres://kachna:kachna@localhost:5432/kachnadocs
# Separate database used by the test suites; scripts/wait-db.mjs creates it if missing.
TEST_DATABASE_URL=postgres://kachna:kachna@localhost:5432/kachnadocs_test

# --- Auth ----------------------------------------------------------------
# Secret used to sign session JWTs. Any long random string in dev.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL_SECONDS=43200

# --- Identity provider ---------------------------------------------------
# Leave DISCORD_CLIENT_ID unset (the default) to use DevIdentityProvider,
# which seeds fixed users and fake roles and needs no network access.
# Set both values to switch to real Discord OAuth. See docs/discord-oauth.md
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# --- App -----------------------------------------------------------------
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

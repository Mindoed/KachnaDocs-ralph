# Ralph loop runtime state — per-session, must not be committed.
# Not anchored to the root: the loop runs from a workspace subdirectory too, and
# an anchored pattern left backend/.claude/ untracked and committable.
**/.claude/ralph-loop.local.md

# Env and secrets
.env
.env.local
.env.*.local

# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Playwright
test-results/
playwright-report/
.blobdiff/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local data volumes
.pgdata/
